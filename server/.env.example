# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Option A (Atlas Cloud): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/taskmanager?retryWrites=true&w=majority
# Option B (Local): mongodb://localhost:27017/taskmanager
# Option C (Auto In-Memory): Leave blank to automatically use in-memory MongoDB for instant zero-setup development!
MONGO_URI=

# JWT Authentication
JWT_SECRET=dev_jwt_secret_key_task_manager_2026_super_secure
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173
