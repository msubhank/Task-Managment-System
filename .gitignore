# ==============================================================================
# Git Ignore Configuration for MERN Task Management System
# ==============================================================================

# Dependencies (Root, Server, and Client)
node_modules/
*/node_modules/

# Environment Variables & Secrets (CRITICAL: Never commit credentials!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*/.env
*/.env.local

# Explicitly track the example template so other developers know what to configure
!.env.example
!*/.env.example

# Production Build Outputs
dist/
build/
*/dist/
*/build/

# Logs and Debugging
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Database binaries & caches
mongodb-binaries/
.cache/

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
